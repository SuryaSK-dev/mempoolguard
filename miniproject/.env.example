# MempoolGuard Environment Configuration (Safe Local Defaults)
# Copy to .env for local overrides

# Local Anvil EVM Node
MEMPOOLGUARD_RPC_HTTP_URL=http://127.0.0.1:8545
MEMPOOLGUARD_RPC_WS_URL=ws://127.0.0.1:8545
MEMPOOLGUARD_CHAIN_ID=31337

# Storage
MEMPOOLGUARD_SQLITE_PATH=data/mempoolguard.db
MEMPOOLGUARD_DB_TIMEOUT_SECONDS=10.0

# Feature Settings
MEMPOOLGUARD_FEATURE_WINDOW_SECONDS=60.0
MEMPOOLGUARD_FEATURE_VERSION=1.0.0

# Risk Policy Thresholds (0-100 scale)
MEMPOOLGUARD_THRESHOLD_ALLOW=30.0
MEMPOOLGUARD_THRESHOLD_FLAG=70.0
MEMPOOLGUARD_DEFAULT_FALLBACK_DECISION=FLAG
MEMPOOLGUARD_POLICY_VERSION=1.0.0

# REST API
MEMPOOLGUARD_API_HOST=127.0.0.1
MEMPOOLGUARD_API_PORT=8000

# Logging
MEMPOOLGUARD_LOG_LEVEL=INFO
